    "mend_detection_expectations": {
        "metapackage": {
            "package": "sentry/sdk",
            "version": "4.0.0",
            "type_in_lockfile": "metapackage",
            "must_appear_in_tree": true,
            "must_have_transitive_child": "sentry/sentry",
            "source_must_be": "registry",
            "failure_modes": [
                "metapackage node absent from tree (Mend skips type:metapackage packages)",
                "sentry/sentry reported as direct dep instead of child of sentry/sdk",
                "metapackage source misclassified as something other than registry"
            ]
        },
        "multiple_version_constraints": {
            "package": "monolog/monolog",
            "constraint": "^2.0 || ^3.0",
            "resolved_version": "3.10.0",
            "must_appear_exactly_once": true,
            "source_must_be": "registry",
            "failure_modes": [
                "two entries for monolog/monolog (one for ^2 and one for ^3)",
                "OR constraint causes package to be dropped entirely",
                "wrong version reported (e.g. a 2.x version instead of 3.10.0)"
            ]
        },
        "stability_flag": {
            "package": "nesbot/carbon",
            "constraint": "^2.0@beta",
            "resolved_version": "2.73.0",
            "stability_flag_value": 10,
            "stability_flag_note": "10 = beta in Composer's internal stability map (stable=0, RC=5, beta=10, alpha=15, dev=20)",
            "must_appear_in_tree": true,
            "source_must_be": "registry",
            "failure_modes": [
                "nesbot/carbon dropped because Mend cannot parse @beta stability suffix in constraint",
                "nesbot/carbon duplicated (one stable entry + one beta entry)",
                "wrong version reported due to stability flag mishandling"
            ]
        },
        "platform_packages_excluded": true,
        "platform_packages": ["php", "ext-json", "ext-curl", "ext-mbstring", "ext-iconv"],
        "all_source_registry": true,
        "no_require_dev_packages": true
    }
}
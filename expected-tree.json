    "total_packages": 18,
    "direct_count": 3,
    "transitive_count": 15,
    "unique_packages": [
        "carbonphp/carbon-doctrine-types:3.2.0",
        "guzzlehttp/psr7:2.9.0",
        "jean85/pretty-package-versions:2.1.1",
        "monolog/monolog:3.10.0",
        "nesbot/carbon:2.73.0",
        "psr/clock:1.0.0",
        "psr/http-factory:1.1.0",
        "psr/http-message:2.0",
        "psr/log:3.0.2",
        "ralouphie/getallheaders:3.0.3",
        "sentry/sdk:4.0.0",
        "sentry/sentry:4.25.0",
        "symfony/deprecation-contracts:v3.6.0",
        "symfony/options-resolver:v8.0.8",
        "symfony/polyfill-mbstring:v1.37.0",
        "symfony/polyfill-php80:v1.37.0",
        "symfony/translation:v6.4.34",
        "symfony/translation-contracts:v3.6.1"
